<Window x:Class="FPVBlackboxTuningAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPV Blackbox Tuning Assistant"
        Width="1280" Height="850" MinWidth="960" MinHeight="700"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="235" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#111915" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="17,25,17,18">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,2,0,26">
            <Border Width="40" Height="40" CornerRadius="12" BorderBrush="#638050" BorderThickness="1" Background="#263322">
              <TextBlock Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,2,0,0" VerticalAlignment="Center">
              <TextBlock Text="FPV BLACKBOX" FontSize="13" FontWeight="Bold" />
              <TextBlock Text="Tuning Assistant" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="ANALYSE" Foreground="#75847A" FontSize="10" FontWeight="Bold" Margin="9,0,0,7" />
          <Border Background="#263429" CornerRadius="8" Padding="10" Margin="0,0,0,3">
            <TextBlock Text="◈   Log importieren" Foreground="{StaticResource AccentBrush}" FontSize="13" />
          </Border>
          <TextBlock Text="▤   Flugübersicht" Foreground="#B9C5BC" FontSize="13" Padding="10,9" />
          <TextBlock Text="⌁   Motoren &amp; Hardware" Foreground="#B9C5BC" FontSize="13" Padding="10,9" />
          <TextBlock Text="⌖   Gyro &amp; Setpoint" Foreground="#B9C5BC" FontSize="13" Padding="10,9" />
          <TextBlock Text="∿   Noise &amp; Filter" Foreground="#B9C5BC" FontSize="13" Padding="10,9" />
          <TextBlock Text="VERLAUF" Foreground="#75847A" FontSize="10" FontWeight="Bold" Margin="9,22,0,7" />
          <Border CornerRadius="8" Padding="10,9" MouseLeftButtonUp="OpenFlightComparison_Click" Cursor="Hand">
            <TextBlock Text="◷   Flugvergleiche" Foreground="#B9C5BC" FontSize="13" />
          </Border>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Daten zuerst. Tuning danach." Foreground="#75847A" FontSize="10" Margin="7,0,0,0" />
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="38,27,38,34" MaxWidth="1200" HorizontalAlignment="Stretch">
        <DockPanel Margin="0,0,0,26">
          <Border DockPanel.Dock="Right" Background="#1D2E22" BorderBrush="#35523C" BorderThickness="1" CornerRadius="18" Padding="11,6">
            <TextBlock Text="●  ANALYSE IN BEREITSCHAFT" Foreground="#C5EFA0" FontSize="10" />
          </Border>
          <TextBlock Text="Analyse  /  Neuer Flug" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="FPV BLACKBOX TUNING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="Erst verstehen.&#10;Dann optimieren." FontSize="34" FontWeight="SemiBold" LineHeight="40" Margin="0,8,0,8" />
        <TextBlock Text="Importiere einen Betaflight-Blackbox-Log. Die App prüft zuerst die Datenqualität und Hardware-Plausibilität, bevor sie Tuning-Hinweise erstellt." Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="710" />
        <Grid Margin="0,23,0,20">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#202C22" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9,0,0,9" Padding="13,12"><TextBlock Text="①  Log &amp; Datenqualität" Foreground="{StaticResource AccentBrush}" FontSize="12" /></Border>
          <Border Grid.Column="1" Background="#141C18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" Padding="13,12"><TextBlock Text="②  Hardwarecheck" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Border>
          <Border Grid.Column="2" Background="#141C18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" Padding="13,12"><TextBlock Text="③  Tuning-Analyse" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Border>
          <Border Grid.Column="3" Background="#141C18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,1" CornerRadius="0,9,9,0" Padding="13,12"><TextBlock Text="④  Empfehlungen" Foreground="{StaticResource MutedBrush}" FontSize="12" /></Border>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="0.9*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Margin="0,0,9,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,14" LastChildFill="False"><TextBlock Text="Blackbox-Log importieren" FontSize="15" FontWeight="SemiBold" /><TextBlock DockPanel.Dock="Right" Text="Betaflight  ·  .BBL" Foreground="{StaticResource MutedBrush}" FontSize="11" /></DockPanel>
              <Border x:Name="DropZone" AllowDrop="True" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop" Background="#141D17" BorderBrush="#526657" BorderThickness="1" CornerRadius="10" MinHeight="238" Padding="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Width="46" Height="46" CornerRadius="14" Background="#202B22" BorderBrush="#3D5141" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12"><TextBlock Text="↑" Foreground="{StaticResource AccentBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Text="Log hier ablegen" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="oder eine Datei auf deinem Computer auswählen" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,14" HorizontalAlignment="Center" />
                  <Button Content="Datei auswählen" Click="ChooseFile_Click" HorizontalAlignment="Center" />
                  <TextBlock x:Name="FileNameText" Text="Nach der Analyse kannst du Drohne und Dateiname für die lokale Speicherung festlegen." Foreground="#78877C" FontSize="10" Margin="0,12,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Background="#20281F" BorderBrush="#39473A" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0">
                <StackPanel><TextBlock Text="Vor der Tuning-Analyse: drei Hardwareprüfungen" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="Nach der Logprüfung führt die App durch Propeller, Motoren und Verbindungen. Bei Messabweichungen erscheint zusätzlich ein gezielter Prüfhinweis. Eine unauffällige Prüfung schließt einen Defekt nicht sicher aus. Die App scrollt jeweils automatisch zur nächsten Frage und danach zur Tuning-Analyse." Foreground="#AAB6AA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
              </Border>
              <Border x:Name="HardwarePromptPanel" Visibility="Collapsed" Background="#28251D" BorderBrush="#77643B" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock x:Name="HardwarePromptText" Foreground="#F1D99A" FontSize="12" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="HardwarePositiveButton" Content="Ja, Mangel gefunden" Click="HardwarePositive_Click" Margin="0,0,8,0" Padding="11,7" />
                    <Button x:Name="HardwareNegativeButton" Content="Keine groben Schäden sichtbar" Click="HardwareNegative_Click" Padding="11,7" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border x:Name="TuningConfigurationPanel" Background="#17231C" BorderBrush="#3D5141" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="TUNING-BASIS · FLIGHT-CONTROLLER-KONFIGURATION" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock Text="Für nachvollziehbare Sollwerte braucht die App die vollständige Originalkonfiguration dieses Controllers. `diff all` enthält nur Abweichungen vom Standard; importiere für die Ausgangswerte `dump all` aus genau der Firmware, die im Blackbox-Log steht." Foreground="#AAB6AA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,9" />
                  <WrapPanel>
                    <Button x:Name="ImportCliConfigurationButton" Content="CLI-Konfiguration laden" Click="ImportCliConfiguration_Click" IsEnabled="False" Padding="11,7" Margin="0,0,10,0" />
                  <CheckBox x:Name="SameFlightControllerCheckBox" Content="Von genau diesem Flight Controller" IsEnabled="False" Checked="SameFlightController_Checked" Unchecked="SameFlightController_Checked" VerticalAlignment="Center" Foreground="#D6E0D7" FontSize="11" />
                  <CheckBox x:Name="ProfileMatchesLogCheckBox" Content="PID- und Rates-Profile galten beim Log" IsEnabled="False" Checked="SameFlightController_Checked" Unchecked="SameFlightController_Checked" VerticalAlignment="Center" Foreground="#D6E0D7" FontSize="11" Margin="14,0,0,0" />
                  </WrapPanel>
                  <TextBlock x:Name="CliConfigurationStatus" Text="Zuerst einen Betaflight-Log laden." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="ShortLogContextPanel" Visibility="Collapsed" Background="#28251D" BorderBrush="#77643B" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="KURZLOGS OHNE FLUGDATEN" Foreground="#F1D99A" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="ShortLogContextText" Foreground="#E5DEC9" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock x:Name="ShortLogContextStatus" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <WrapPanel x:Name="ShortLogContextButtons" Margin="0,10,0,0">
                    <Button Content="Ja, wahrscheinlich Crash Flip" Click="ShortLogCrashFlip_Click" Margin="0,0,8,0" Padding="10,7" />
                    <Button Content="Nein" Click="ShortLogOther_Click" Margin="0,0,8,0" Padding="10,7" />
                    <Button Content="Unsicher" Click="ShortLogUnknown_Click" Padding="10,7" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border x:Name="TuningMetricsPanel" Visibility="Collapsed" Background="#17231C" BorderBrush="#3D5141" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="SOLL-/IST-DREHRATE · VERGLEICHSKENNZAHL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="SetpointTrackingText" Foreground="#D6E0D7" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock x:Name="FlightModeNoticeText" Visibility="Collapsed" Foreground="#F1D99A" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="Ø = mittlere Abweichung, P95 = 95 % der Messwerte lagen darunter. Gesamtwerte und — soweit genügend Daten vorliegen — getrennte Werte je Flugmodus. Nur ähnliche Manöver und Rateprofile vergleichen; daraus folgt allein keine PID- oder Filterempfehlung." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="PidActivityPanel" Visibility="Collapsed" Background="#17231C" BorderBrush="#3D5141" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="PID-TERM-AKTIVITÄT · BESCHREIBENDE MESSWERTE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="PidActivityText" Foreground="#D6E0D7" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="Øabs = mittlere absolute Aktivität · RMS = quadratischer Mittelwert · Spitze = größter absoluter Messwert. Decoder-Einheiten; abhängig von Flugmanöver und Modusfolge, daher keine PID-Empfehlung." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
              <Button x:Name="ContinueTuningButton" Content="Weiter zur Tuning-Analyse" Click="ContinueTuning_Click" Visibility="Collapsed" HorizontalAlignment="Left" Padding="13,8" Margin="0,14,0,0" />
              <Border x:Name="TuningAnalysisPanel" Visibility="Collapsed" Background="#17231C" BorderBrush="#3D5141" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="TUNING-ANALYSE · DATENLAGE UND NÄCHSTER SCHRITT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                  <TextBlock x:Name="TuningReadinessText" Foreground="#D6E0D7" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                  <TextBlock Text="Erkannte Flugmodi je Session" Foreground="#D6E0D7" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="TuningModeCoverageText" Foreground="#AAB6AA" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="CLI-Ausgangsbasis" Foreground="#D6E0D7" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock x:Name="TuningBaselineReadinessText" Foreground="#AAB6AA" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="Tuning-Ziel und Nutzerbeobachtung" Foreground="#D6E0D7" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <ComboBox x:Name="TuningGoalComboBox" SelectedIndex="0" Width="360" HorizontalAlignment="Left" Margin="0,5,0,0">
                    <ComboBoxItem Content="Ziel auswählen" Tag="None" />
                    <ComboBoxItem Content="Propwash im Acro-Modus reduzieren" Tag="Propwash" />
                    <ComboBoxItem Content="Maximale Drehrate senken (ACTUAL)" Tag="LowerActualRate" />
                  </ComboBox>
                  <TextBlock x:Name="TuningGoalHelpText" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <WrapPanel Margin="0,7,0,0">
                    <CheckBox x:Name="PropwashObservedCheckBox" Content="Propwash/Bounceback im Acro-Flug beobachtet" Checked="TuningInput_Changed" Unchecked="TuningInput_Changed" Foreground="#D6E0D7" VerticalAlignment="Center" Margin="0,0,12,5" />
                    <CheckBox x:Name="PropwashRollAffectedCheckBox" Content="Roll betroffen" Checked="TuningInput_Changed" Unchecked="TuningInput_Changed" Foreground="#D6E0D7" VerticalAlignment="Center" Margin="0,0,10,5" />
                    <CheckBox x:Name="PropwashPitchAffectedCheckBox" Content="Pitch betroffen" Checked="TuningInput_Changed" Unchecked="TuningInput_Changed" Foreground="#D6E0D7" VerticalAlignment="Center" Margin="0,0,12,5" />
                    <ComboBox x:Name="MotorTemperatureComboBox" SelectedIndex="0" SelectionChanged="TuningInput_Changed" Width="210" Margin="0,0,0,5">
                      <ComboBoxItem Content="Motorwärme: nicht angegeben" Tag="Unreported" />
                      <ComboBoxItem Content="Motoren kühl" Tag="Cool" />
                      <ComboBoxItem Content="Motoren warm" Tag="Warm" />
                      <ComboBoxItem Content="Motoren heiß" Tag="Hot" />
                    </ComboBox>
                  </WrapPanel>
                  <CheckBox x:Name="HardwareChecksCompleteCheckBox" Content="Propeller, Motoren und Verbindungen geprüft; keine grobe Auffälligkeit beobachtet" Checked="TuningInput_Changed" Unchecked="TuningInput_Changed" Foreground="#D6E0D7" FontSize="10" Margin="0,3,0,0" />
                  <TextBlock Text="Eine unauffällige Sichtprüfung schließt keinen Defekt sicher aus. Alle Zahlenwerte sind begrenzte, manuell zu prüfende Versuche und keine automatische Diagnose." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <Button x:Name="CalculateTuningRecommendationsButton" Content="Messwerte und Ziel bewerten" Click="CalculateTuningRecommendations_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,0" />
                  <TextBlock x:Name="CliProposalStatusText" Text="Noch kein begründeter Zahlenvorschlag erstellt." Foreground="#F1D99A" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                  <Button x:Name="ReviewCliProposalButton" Content="Vorschlag prüfen und CLI-Datei erstellen" Click="ReviewCliProposal_Click" IsEnabled="False" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,0" />
                  <TextBlock Text="Messwerte belegen keine Ursache allein. Der jeweilige Vorschlag verlangt passende Acro-Daten und eine bestätigte vollständige FC-Basis. Filteränderungen bleiben bis zu einer Frequenz-/Rauschdiagnose gesperrt; der CLI-Export flasht den Controller nicht." Foreground="#F1D99A" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="20" Margin="9,0,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,14" LastChildFill="False"><TextBlock Text="Log-Status" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Nach Analyse" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Right" /></DockPanel>
              <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Datei" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="FileStatus" Grid.Column="1" Text="Noch nicht geladen" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" TextTrimming="CharacterEllipsis" MaxWidth="190" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Drohne" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="DroneStatus" Grid.Column="1" Text="Noch nicht zugeordnet" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" TextTrimming="CharacterEllipsis" MaxWidth="190" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Speicherung" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="StorageStatus" Grid.Column="1" Text="Lokal · Dokumente" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" TextTrimming="CharacterEllipsis" MaxWidth="190" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Blackbox-Header" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="HeaderStatus" Grid.Column="1" Text="Ausstehend" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Binärdatenbereich" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="PayloadStatus" Grid.Column="1" Text="Ausstehend" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Flug-Frames dekodiert" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="FramesStatus" Grid.Column="1" Text="Decoder 1.1.1 bereit" Foreground="#B8EF7B" FontSize="11" Padding="0,10" /></Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Hardware-Status" Foreground="{StaticResource MutedBrush}" FontSize="12" Padding="0,10" /><TextBlock x:Name="HardwareStatus" Grid.Column="1" Text="Noch nicht geprüft" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,10" /></Grid>
              <Border Background="#28251D" BorderBrush="#524934" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="DiagnosticNoticeTitle" Text="WICHTIG · KEINE VORZEITIGE DIAGNOSE" Foreground="#F1C978" FontSize="10" FontWeight="Bold" /><TextBlock x:Name="DiagnosticNoticeText" Text="Ein Datenbereich belegt noch keine erfolgreich dekodierbaren Flug-Frames. Motorwerte werden erst nach vollständiger BBL-Dekodierung bewertet." Foreground="#B6B2A5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
            </StackPanel>
          </Border>
        </Grid>

        <DockPanel Margin="0,23,0,11" LastChildFill="False"><TextBlock Text="Der Analyseablauf" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Nachvollziehbar in jeder Phase" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Right" /></DockPanel>
        <UniformGrid Columns="3">
          <Border Background="#161E19" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="◉  DATENQUALITÄT ZUERST" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Header und Nutzdaten prüfen. Fehlende oder unlesbare Frames stoppen die Analyse." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
          <Border Background="#161E19" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="5,0"><StackPanel><TextBlock Text="⌁  HARDWARE-PLAUSIBILITÄT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Mehrere Signale gemeinsam bewerten und gezielte Nutzerprüfungen anbieten." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
          <Border Background="#161E19" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="↗  TUNING MIT MESSBEZUG" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Empfehlungen erst nach bestandenem Gate und begründet durch Logdaten." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Border>
        </UniformGrid>
        <TextBlock Text="Sicherheit: Vor mechanischen Prüfungen Akku abziehen und Propeller abnehmen. Nutzerprüfungen grenzen mögliche Ursachen ein, beweisen aber keinen Defekt." Foreground="#7D8B81" FontSize="10" TextWrapping="Wrap" Margin="1,16,0,0" />
        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,12" />
        <DockPanel LastChildFill="False"><TextBlock Text="FPV Blackbox Tuning Assistant · Beta 0.2.0-beta.18" Foreground="#718076" FontSize="10" /><TextBlock Text="BBL-Decoder bbl_parser 1.1.1" Foreground="#718076" FontSize="10" DockPanel.Dock="Right" /></DockPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
