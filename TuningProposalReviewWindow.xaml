<Window x:Class="FPVBlackboxTuningAssistant.TuningProposalReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuning-Vorschlag prüfen" Width="1360" Height="760" MinWidth="1000" MinHeight="600"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="WrappedGridText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="3" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="TUNING-ENTWURF · VOR DEM EXPORT PRÜFEN" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
      <TextBlock Text="Prüfe zuerst die Änderungsdetails und danach den exakten CLI-Text, der gespeichert wird." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>
    <TextBlock x:Name="ConfigurationSummaryText" Grid.Row="1" Foreground="#D6E0D7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
    <TabControl x:Name="ReviewTabs" Grid.Row="2" Background="#141D17" Foreground="#D6E0D7">
      <TabItem x:Name="ChangeReviewTab" Header="Änderungsdetails">
        <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="#141D17" Foreground="#D6E0D7" RowBackground="#17231C" AlternatingRowBackground="#1B2820" BorderBrush="{StaticResource LineBrush}" HorizontalGridLinesBrush="{StaticResource LineBrush}" VerticalGridLinesBrush="{StaticResource LineBrush}" SelectionMode="Single">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Bereich" Binding="{Binding ScopeLabel}" Width="82" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="95" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Vorher" Binding="{Binding PreviousValue}" Width="65" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Vorschlag" Binding="{Binding ProposedValue}" Width="75" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Begründung" Binding="{Binding Reason}" Width="1.25*" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Messbeleg" Binding="{Binding Evidence}" Width="1.6*" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Erwartete Wirkung" Binding="{Binding ExpectedEffect}" Width="1.2*" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Risiko" Binding="{Binding Risk}" Width="1.2*" ElementStyle="{StaticResource WrappedGridText}" />
            <DataGridTextColumn Header="Nachflug-Prüfung" Binding="{Binding ValidationPlan}" Width="1.5*" ElementStyle="{StaticResource WrappedGridText}" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem x:Name="CliDraftTab" Header="CLI-Entwurf">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="Dies ist genau der Text, der beim Export gespeichert wird. Er enthält keine Flash-Anweisung und kein `save`." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBox x:Name="CliDraftPreviewText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0E1511" Foreground="#D6E0D7" BorderBrush="{StaticResource LineBrush}" Padding="10" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#28251D" BorderBrush="#77643B" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
      <TextBlock Text="Der Export enthält nur die unten aufgeführten `set`-Befehle und Kommentare. Er flasht den Controller nicht und enthält kein `save`. Sichere zuerst den aktuellen `dump all`, prüfe den Entwurf und übernimm ihn danach selbst im Betaflight-CLI." Foreground="#F1D99A" FontSize="11" TextWrapping="Wrap" />
    </Border>
    <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
      <CheckBox x:Name="ReviewConfirmedCheckBox" Content="Ich habe Begründungstabelle und CLI-Text geprüft." IsEnabled="False" Checked="ReviewConfirmed_Checked" Unchecked="ReviewConfirmed_Checked" Foreground="#D6E0D7" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Schließen" Click="Close_Click" Background="#263429" Foreground="#D6E0D7" BorderBrush="#526657" Margin="0,0,9,0" />
        <Button x:Name="ExportButton" Content="CLI-Entwurf speichern" Click="Export_Click" IsEnabled="False" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
